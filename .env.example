# Copy to .env.local. Public values only: never the Supabase secret / service_role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Google's sign-in button (ARCHITECTURE.md 1.5): the OAuth client ID ending in
# .apps.googleusercontent.com. Public. Leave empty to use the redirect login.
VITE_GOOGLE_CLIENT_ID=
